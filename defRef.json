{
    "features": {
        "roundabout": {
            "customData": {
                "raConfig": {
                    "compacts": {
                        "when_splitFor_changes_call_hydrate": 0,
                        "when_join_changes_call_hydrate": 0,
                        "when_readonly_changes_call_hydrate": 0,
                        "when_maxJoin_changes_call_hydrate": 0
                    }
                }
            },
            "withAttrs": {
                "for": "for",
                "_for": {
                    "mapsTo": "splitFor",
                    "parser": "splitter",
                    "parserOptions": {
                        "delimiter": " "
                    },
                    "sourceOfTruth": true
                },
                "join": "join",
                "_join": {
                    "instanceOf": "Boolean",
                    "valIfNull": false
                },
                "readonly": "readonly",
                "_readonly": {
                    "instanceOf": "Boolean",
                    "valIfNull": false
                },
                "maxJoin": "max-join",
                "_maxJoin": {
                    "instanceOf": "Number"
                }
            }
        },
        "truthSourcer": {
            "customData": {
                "observedAttributes": [
                    "for"
                ]
            }
        }
    }
}
